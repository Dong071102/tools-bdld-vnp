# ==========================================
# Cấu hình biến môi trường cho Tool BDLD VNP
# ==========================================

# ------------------------------------------
# 1. Cấu hình Database SQL Server (Dùng chung cho cả Crawler & Định vị Backend)
# ------------------------------------------
DB_SERVER=your_db_server_ip
DB_HOST=your_db_server_ip
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=your_db_password
DB_NAME=caw_powerbi_db

# ------------------------------------------
# 2. Cấu hình Crawler Power BI (Python FastAPI Service)
# ------------------------------------------
# URL public của báo cáo Power BI (Dán URL public mới vào đây khi link bị thay đổi)
POWERBI_URL=https://app.powerbi.com/view?r=your_powerbi_view_key

# (Tùy chọn) Khóa tài nguyên và Access Token nếu chỉ định thủ công
# POWERBI_RESOURCE_KEY=
# POWERBI_ACCESS_TOKEN=
# POWERBI_QUERY_URL=

# Cổng chạy của Python Crawler Backend (Mặc định container: 8000)
CRAWLER_PORT=8000

# URL gọi nội bộ từ Crawler sang Node.js Backend
DINHVI_BACKEND_URL=http://vnp-dinhvi-backend:5000

# ------------------------------------------
# 3. Cấu hình Định Vị Backend (Node.js Express Service)
# ------------------------------------------
# Cổng chạy của Node.js Backend (Mặc định container: 5000)
DINHVI_PORT=5000

# Khóa bí mật ký JWT Token cho phiên đăng nhập người dùng
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# ------------------------------------------
# 4. Cấu hình Lọc Tồn Backend (Node.js Service)
# ------------------------------------------
LOCTON_PORT=3001

# ------------------------------------------
# 5. Cấu hình Frontend & Múi giờ
# ------------------------------------------
# Cổng public truy cập giao diện Web Dashboard (Nginx Frontend)
FRONTEND_PORT=9999

# Múi giờ hệ thống
TZ=Asia/Ho_Chi_Minh
